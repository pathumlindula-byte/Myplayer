<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners
                android:bottomLeftRadius="8dp"
                android:bottomRightRadius="8dp"
                android:topLeftRadius="6dp"
                android:topRightRadius="10dp" />
            <gradient
                android:angle="270"
                android:endColor="#082E12"
                android:startColor="#1F8A3B" />
            <stroke
                android:width="1.2dp"
                android:color="#888CFFAF" />
        </shape>
    </item>

    <item android:top="9dp">
        <shape android:shape="rectangle">
            <corners
                android:bottomLeftRadius="8dp"
                android:bottomRightRadius="8dp"
                android:topLeftRadius="4dp"
                android:topRightRadius="4dp" />
            <gradient
                android:angle="270"
                android:centerColor="#158531"
                android:endColor="#0A4519"
                android:startColor="#35CC58" />
            <stroke
                android:width="1.4dp"
                android:color="#BBAAFFC2" />
        </shape>
    </item>

    <item
        android:bottom="28dp"
        android:left="4dp"
        android:right="4dp"
        android:top="10dp">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <gradient
                android:angle="270"
                android:endColor="#12FFFFFF"
                android:startColor="#B8FFFFFF" />
        </shape>
    </item>

</layer-list>
