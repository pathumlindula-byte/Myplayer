<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Back tab & body -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="8dp"
                android:topRightRadius="8dp"
                android:bottomLeftRadius="9dp"
                android:bottomRightRadius="9dp" />
            <gradient
                android:angle="270"
                android:startColor="#0E4A22"
                android:endColor="#072611" />
            <stroke
                android:width="1.2dp"
                android:color="#5CE67A" />
        </shape>
    </item>

    <!-- Front glossy 3D glass body -->
    <item
        android:top="10dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="7dp"
                android:topRightRadius="7dp"
                android:bottomLeftRadius="8dp"
                android:bottomRightRadius="8dp" />
            <gradient
                android:angle="270"
                android:startColor="#34C759"
                android:centerColor="#167A34"
                android:endColor="#0A3B19" />
            <stroke
                android:width="1dp"
                android:color="#99FFAF" />
        </shape>
    </item>

    <!-- Top glass highlight sheen -->
    <item
        android:top="11dp"
        android:left="4dp"
        android:right="4dp"
        android:bottom="28dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="5dp"
                android:topRightRadius="5dp"
                android:bottomLeftRadius="12dp"
                android:bottomRightRadius="12dp" />
            <gradient
                android:angle="270"
                android:startColor="#70FFFFFF"
                android:endColor="#10FFFFFF" />
        </shape>
    </item>

</layer-list>
