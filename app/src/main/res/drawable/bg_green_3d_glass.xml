<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#AA7CFF8A" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:centerColor="#46E865"
                        android:endColor="#158A2E"
                        android:startColor="#E9FFED" />
                    <stroke
                        android:width="2dp"
                        android:color="#FFFFFF" />
                </shape>
            </item>
            <item
                android:bottom="22dp"
                android:left="8dp"
                android:right="8dp"
                android:top="4dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:endColor="#20FFFFFF"
                        android:startColor="#F2FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:centerColor="#0B3D17"
                        android:endColor="#041909"
                        android:startColor="#156628" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:left="1dp"
                android:right="1dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:centerColor="#168A32"
                        android:endColor="#0B541D"
                        android:startColor="#39D45B" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#999CFFAF" />
                </shape>
            </item>
            <item
                android:bottom="22dp"
                android:left="9dp"
                android:right="9dp"
                android:top="4dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:endColor="#06FFFFFF"
                        android:startColor="#B8FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
