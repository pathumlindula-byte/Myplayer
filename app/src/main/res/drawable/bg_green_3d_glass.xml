<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed / Light-Flash 3D Green Glass -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="26dp" />
                    <solid android:color="#D839FF14" />
                    <padding
                        android:bottom="2dp"
                        android:left="2dp"
                        android:right="2dp"
                        android:top="2dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <gradient
                        android:angle="270"
                        android:centerColor="#45F57A"
                        android:endColor="#1DB954"
                        android:startColor="#EBFFEF" />
                    <stroke
                        android:width="2dp"
                        android:color="#FFFFFF" />
                </shape>
            </item>
            <item
                android:bottom="20dp"
                android:left="4dp"
                android:right="4dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <gradient
                        android:angle="270"
                        android:endColor="#44FFFFFF"
                        android:startColor="#F8FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default Realistic 3D Green Glass -->
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <gradient
                        android:angle="270"
                        android:centerColor="#0E4D24"
                        android:endColor="#051F0E"
                        android:startColor="#197A3A" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#6669F098" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <gradient
                        android:angle="270"
                        android:centerColor="#147A38"
                        android:endColor="#0A4720"
                        android:startColor="#2EC964" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#AA9EFFC2" />
                </shape>
            </item>
            <item
                android:bottom="20dp"
                android:left="4dp"
                android:right="4dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <gradient
                        android:angle="270"
                        android:endColor="#08FFFFFF"
                        android:startColor="#99FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
