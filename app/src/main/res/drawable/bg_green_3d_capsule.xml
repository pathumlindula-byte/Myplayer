<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ඔබනකොට / Pressed State (Light එකක් වගේ පත්තු වෙනවා) -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Outer Neon Glow -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="26dp" />
                    <solid android:color="#6639FF14" />
                    <padding
                        android:bottom="2dp"
                        android:left="2dp"
                        android:right="2dp"
                        android:top="2dp" />
                </shape>
            </item>
            <!-- Bright Lit Glass Body -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <gradient
                        android:angle="270"
                        android:centerColor="#28D85A"
                        android:endColor="#148F3D"
                        android:startColor="#9EFFB8" />
                    <stroke
                        android:width="2dp"
                        android:color="#E8FFF0" />
                </shape>
            </item>
            <!-- Top Glossy Light Reflection -->
            <item
                android:bottom="22dp"
                android:left="4dp"
                android:right="4dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <gradient
                        android:angle="270"
                        android:endColor="#15FFFFFF"
                        android:startColor="#B8FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal State (3D Green Glass) -->
    <item>
        <layer-list>
            <!-- 3D Bottom Depth Shadow -->
            <item android:top="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <gradient
                        android:angle="270"
                        android:centerColor="#0E4D24"
                        android:endColor="#062410"
                        android:startColor="#197A3A" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#6669F098" />
                </shape>
            </item>
            <!-- Main 3D Green Glass Body -->
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <gradient
                        android:angle="270"
                        android:centerColor="#147A38"
                        android:endColor="#0A4720"
                        android:startColor="#2EC964" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#99A8FFCA" />
                </shape>
            </item>
            <!-- Top Glass Highlight -->
            <item
                android:bottom="22dp"
                android:left="4dp"
                android:right="4dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <gradient
                        android:angle="270"
                        android:endColor="#08FFFFFF"
                        android:startColor="#85FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
