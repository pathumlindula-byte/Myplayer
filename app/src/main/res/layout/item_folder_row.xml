<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="18dp"
    android:paddingVertical="11dp">

    <FrameLayout
        android:layout_width="68dp"
        android:layout_height="54dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/ivFolderIcon"
            android:layout_width="64dp"
            android:layout_height="50dp"
            android:layout_gravity="bottom|start"
            android:contentDescription="Folder Icon"
            android:scaleType="fitXY"
            android:src="@drawable/ic_folder_3d_green" />

        <ImageView
            android:id="@+id/ivFolderBadge"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="23dp"
            android:layout_marginBottom="9dp"
            android:contentDescription="Camera Badge"
            android:src="@android:drawable/ic_menu_camera"
            android:tint="#FFFFFF"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvNewBadge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="1dp"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFolderName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Camera"
            android:textColor="#F5F5F5"
            android:textSize="17sp"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/tvVideoCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="3 videos"
            android:textColor="#9E9E9E"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>
