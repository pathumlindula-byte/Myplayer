<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:resize_mode="fit"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <TextView
        android:id="@+id/tvSubtitleOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="78dp"
        android:background="#99000000"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#44000000">

        <!-- Top Bar (MX Player Structure) -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="14dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_green_3d_glass"
                android:contentDescription="Back"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_media_previous"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvVideoTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:ellipsize="marquee"
                android:focusable="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:text="Zeno Player"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSpeed"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_green_3d_glass"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="1.0x"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_green_3d_glass"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="SRT"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnRotate"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_green_3d_glass"
                android:contentDescription="Rotate Screen"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_rotate"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnLock"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_green_3d_glass"
                android:contentDescription="Lock Controls"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_lock_lock"
                app:tint="#FFFFFF" />

        </LinearLayout>

        <!-- Center Controls (MX Player Structure) -->
        <LinearLayout
            android:id="@+id/centerControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnRewind"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_green_3d_glass"
                android:contentDescription="Rewind 10s"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_media_rew"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginHorizontal="28dp"
                android:background="@drawable/bg_green_3d_glass"
                android:contentDescription="Play or Pause"
                android:padding="17dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_media_pause"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_green_3d_glass"
                android:contentDescription="Forward 10s"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_media_ff"
                app:tint="#FFFFFF" />

        </LinearLayout>

        <!-- Bottom Bar (MX Player Timeline + Quick Controls) -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressTint="#39FF14"
                    android:thumbTint="#FFFFFF" />

                <TextView
                    android:id="@+id/tvTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnAspectRatio"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_green_3d_glass"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="FIT"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnZoom"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_green_3d_glass"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="ZOOM 100%"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvSubtitleStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_green_3d_glass"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="SRT Ready"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

    <ImageButton
        android:id="@+id/btnUnlock"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="top|start"
        android:layout_margin="18dp"
        android:background="@drawable/bg_green_3d_glass"
        android:contentDescription="Unlock Controls"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_lock_idle_lock"
        android:visibility="gone"
        app:tint="#FFFFFF" />

</FrameLayout>
