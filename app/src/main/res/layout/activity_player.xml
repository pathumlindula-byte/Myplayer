<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:resize_mode="fit"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <!-- Touch & Gesture Layer -->
    <View
        android:id="@+id/gestureOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true" />

    <!-- Center Quick Feedback Pill -->
    <TextView
        android:id="@+id/tvCenterFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_zeno_green_orb"
        android:gravity="center"
        android:minWidth="76dp"
        android:minHeight="48dp"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Top & Secondary 3D Green Glass Controls Overlay -->
    <LinearLayout
        android:id="@+id/controlsTopGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#66000000"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <!-- Row 1: Back + Title + Audio/Sub/More/HW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_zeno_green_orb"
                android:contentDescription="Back"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvVideoTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:ellipsize="marquee"
                android:focusable="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:text="Zeno Player"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnAudioTrack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_zeno_green_orb"
                android:contentDescription="Audio Track"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_media_ff"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnSubtitle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_zeno_green_orb"
                android:contentDescription="Subtitles"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnMoreOptions"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_zeno_green_orb"
                android:contentDescription="More Options"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_more"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/btnDecoder"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_zeno_green_orb"
                android:gravity="center"
                android:text="HW"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2: Equalizer / Speed / Aspect / Rotate / Next -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical|start"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnEqualizer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_zeno_green_orb"
                android:contentDescription="Equalizer"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_preferences"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/btnSpeed"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_zeno_green_orb"
                android:gravity="center"
                android:text="1X"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnAspectRatio"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_zeno_green_orb"
                android:contentDescription="Aspect Ratio"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_crop"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnRotate"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_zeno_green_orb"
                android:contentDescription="Rotate Screen"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_rotate"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnNextTop"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_zeno_green_orb"
                android:contentDescription="Next Video"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_media_next"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Controls Overlay -->
    <LinearLayout
        android:id="@+id/controlsBottomGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#88000000"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="14dp">

        <!-- Seekbar + Current/Total Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="46dp"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressDrawable="@drawable/bg_zeno_green_seekbar"
                android:splitTrack="false"
                android:thumb="@drawable/bg_zeno_green_orb" />

            <TextView
                android:id="@+id/tvTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="46dp"
                android:gravity="end"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bottom Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnLock"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_zeno_green_orb"
                android:contentDescription="Lock Controls"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_lock_idle_lock"
                android:tint="#FFFFFF" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_zeno_green_orb"
                android:contentDescription="Previous Video"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_media_previous"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="18dp"
                android:background="@drawable/bg_zeno_green_orb"
                android:contentDescription="Play or Pause"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_media_play"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_zeno_green_orb"
                android:contentDescription="Next Video"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_media_next"
                android:tint="#FFFFFF" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnRepeat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_zeno_green_orb"
                android:contentDescription="Repeat Mode"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_rotate"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnFullscreenResize"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_zeno_green_orb"
                android:contentDescription="Resize Video"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_zoom"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Locked Mode Unlock Button -->
    <ImageButton
        android:id="@+id/btnUnlock"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_zeno_green_orb"
        android:contentDescription="Unlock Controls"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_lock_idle_lock"
        android:tint="#FFFFFF"
        android:visibility="gone" />

</FrameLayout>
